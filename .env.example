# Copy to .env.local (development) or .env (Docker) and fill in. Never commit the real file.

# --- Public (baked into the build) -------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@example.de

# --- Stripe (dashboard.stripe.com → Developers → API keys) -------------------
# Use sk_test_… while testing, sk_live_… in production.
STRIPE_SECRET_KEY=
# Optional: an *inclusive* 19 % tax rate (Products → Tax rates) so receipts show the VAT.
STRIPE_TAX_RATE_ID=
# Optional: let Stripe create a PDF invoice for every order (costs extra per invoice).
STRIPE_INVOICES=false

# --- Admin area (/admin) ------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# --- DHL Parcel DE Shipping API v2 --------------------------------------------
# API key: app on developer.dhl.com. User/password + billing number: DHL Geschäftskundenportal.
# Sandbox test values from the DHL docs: user-valid / SandboxPasswort2023! / 33333333330101
DHL_SANDBOX=true
DHL_API_KEY=
DHL_USER=
DHL_PASSWORD=
DHL_BILLING_NUMBER=
# Label size, see DHL docs (910-300-700 = A5 PDF, 910-300-410 = 103x150 thermal)
DHL_PRINT_FORMAT=910-300-700

# Sender address printed on the label
SHIPPER_NAME=India House
SHIPPER_STREET=
SHIPPER_HOUSE=
SHIPPER_POSTAL_CODE=
SHIPPER_CITY=
SHIPPER_EMAIL=

# --- Shipping notification e-mail (any SMTP mailbox) --------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="India House <kontakt@example.de>"
